# Every variable the apex CLI reads. Offline commands (--offline, simulate) need none of the
# network ones. Test values only; never put real keys in a committed file.

# --- network (live mode) ---
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
APEX_REGISTER_CONTRACT_ID=

# --- signing keys (live mode). Each command signs with the role it needs. ---
# registrar: init, member add/deactivate/rotate, custodian set
REGISTRAR_SECRET=
# apex: open, post
APEX_SECRET=
# custodian: attest (or pass --custodian S... on the command line)
CUSTODIAN_SECRET=
# fee payer for board responses, close and watch (boards hold no XLM)
SOURCE_SECRET=
# officer keys for board_account auth entries: {"boards":[{"no","board","threshold","officers":[{"secret"}]}]}
BOARD_KEYS_FILE=

# --- apex secrets (never published) ---
# 32-byte hex key: per-line salts (HMAC) and the per-period shuffle seed
APEX_SALT_KEY=
# hex salt the registrar mixes into licence-number hashes
REGISTRAR_SALT=

# --- register config overrides used by `apex init` (seconds) ---
CONFIRM_WINDOW_SECS=864000
ATTEST_WINDOW_SECS=432000

# --- local files ---
# where build writes trees/packs and the offline model keeps state.json
APEX_DATA_DIR=var
